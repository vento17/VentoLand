---
// Progetti esterni: loghi in public/logo/partner/, link qui sotto.
const partners = [
  { nome: 'DeltaProcess', logo: '/logo/partner/deltaprocess.png', url: 'https://www.deltaprocess.it/' },
  { nome: 'VoxelStudio',  logo: '/logo/partner/voxelstudio.png',  url: 'https://www.instagram.com/studio_voxel_ve/' },
  { nome: 'MagnumPy',     logo: '/logo/partner/magnumpy.jpg',     url: 'https://www.patreon.com/c/Magnumpy' },
];
import fs from 'node:fs';
const exists = (p: string) => fs.existsSync('public' + p);
---
<section class="partners">
  <div class="wrap">
    <div class="eyebrow" style="text-align:center">Sviluppati con e per</div>
    <div class="row">
      {partners.map(p => (
        <a href={p.url} target="_blank" rel="noopener" title={p.nome}>
          {exists(p.logo) ? <img src={p.logo} alt={p.nome} loading="lazy" /> : <span class="ph">{p.nome}</span>}
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .partners { border-top: 1px solid var(--line); padding: 3rem 0 1rem; margin-top: 4rem; }
  .row { display: flex; flex-wrap: wrap; gap: 3rem 4rem; align-items: center; justify-content: center; }
  .row a { display: block; opacity: .7; }
  .row a:hover { opacity: 1; }
  .row img { height: 160px; width: auto; }
  @media (max-width: 640px) { .row img { height: 110px; } .row { gap: 2rem; } }
  .ph { font-family: var(--mono); font-size: .8rem; color: var(--fg-3); border: 1px dashed var(--line); padding: .8rem 1.2rem; }
</style>
